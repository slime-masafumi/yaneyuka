rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'slime-a@outlook.com';
    }
    // 投稿者本人か管理者か。uid 未設定の既存ドキュメントは管理者のみ触れる。
    function isOwnerOrAdmin() {
      return isAdmin()
        || (request.auth != null
            && resource.data.get('uid', null) == request.auth.uid);
    }

    // 掲示板本体（未ログインでも閲覧可）
    match /forumPosts/{postId} {
      allow read: if true;
      // 作成: 他人になりすませないよう uid を自分のものに固定する
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // 更新: 自分の投稿または管理者のみ。かつ uid の付け替えを禁止
      // （旧ルールは「ログイン済みなら誰でも update 可」で、他人の投稿を改竄できた）
      allow update: if isOwnerOrAdmin()
        && request.resource.data.uid == resource.data.uid;
      // 削除: 自分の投稿または管理者（slime-a@outlook.com）のみ
      allow delete: if isOwnerOrAdmin();

      // 返信（未ログインでも閲覧可）
      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
        allow update: if isOwnerOrAdmin()
          && request.resource.data.uid == resource.data.uid;
        // 削除: 自分の返信または管理者（slime-a@outlook.com）のみ
        allow delete: if isOwnerOrAdmin();
      }
    }

    // 掲示板の通報。
    // 不適切な投稿を利用者が報告するための箱。管理者だけが中身を見て対応する。
    // 通報者は自分が出した通報も読み返せない（誰が通報したかを他人に見せないため、
    // 一覧を引ける相手を管理者に限定している）。
    match /forumReports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'postId', 'replyId', 'reason', 'createdAt', 'status'
        ])
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 200
        && request.resource.data.status == 'open';
    }

    // 各ユーザー配下のブックマーク（本人のみ）
    match /users/{uid}/forumBookmarks/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Team Boards（オーナー or メンバーのみ）
    match /boards/{boardId} {
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid
            || (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids));
      // 作成は自分がオーナーのボードのみ
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      // 更新・削除はオーナーのみ
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // ボード配下のタスク（ボードのオーナー・メンバーのみ）
      match /tasks/{taskId} {
        allow read, create, update, delete: if request.auth != null
          && (
            get(/databases/$(database)/documents/boards/$(boardId)).data.ownerUid == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/boards/$(boardId)).data.memberUids
          );
      }
    }

    // ユーザープロファイル（読み出しはログイン済み全ユーザー、書き込みは本人のみ）
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // そのほかユーザー配下データは原則本人のみ（必要に応じて拡張）
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ファイル転送ツールの設定
    match /config/{docId} {
      allow read: if request.auth != null;
    }

    // ファイル転送ツールの使用量メトリクス
    // クライアントが increment() で加算する設計のため、1回の書き込みで動かせる量を
    // 1ファイル上限（storage.rules と同じ 50MB）に制限し、減算も禁止する。
    // 旧ルールは site_* を誰でも自由な値に書き換えられ、サイト全体の残量表示を
    // 改竄して他ユーザーのアップロードを止められた。
    function usageIdAllowed(usageId) {
      return usageId.matches('^site_.*')
        || usageId.matches('^' + request.auth.uid + '_.*');
    }
    function usageShapeOk() {
      return request.resource.data.keys().hasOnly(['uploadedBytes', 'downloadedBytes'])
        && request.resource.data.get('uploadedBytes', 0) is number
        && request.resource.data.get('downloadedBytes', 0) is number;
    }
    function usageStepOk(field) {
      return request.resource.data.get(field, 0) - resource.data.get(field, 0) >= 0
        && request.resource.data.get(field, 0) - resource.data.get(field, 0) <= 52428800;
    }
    match /usage/{usageId} {
      allow read: if request.auth != null && usageIdAllowed(usageId);
      allow create: if request.auth != null
        && usageIdAllowed(usageId)
        && usageShapeOk()
        && request.resource.data.get('uploadedBytes', 0) <= 52428800
        && request.resource.data.get('downloadedBytes', 0) <= 52428800;
      allow update: if request.auth != null
        && usageIdAllowed(usageId)
        && usageShapeOk()
        && usageStepOk('uploadedBytes')
        && usageStepOk('downloadedBytes');
    }

    // ファイル転送ツールのアップロードメタデータ
    match /uploads/{uploadId} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'owner',
          'fileName',
          'size',
          'path',
          'downloadUrl',
          'createdAt',
          'expiresAt',
          'shortCode',
          'retentionDays'
        ]);

      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
    }

    // 短縮共有リンク
    match /shareLinks/{code} {
      // 単体取得（get）のみ許可。共有コードを知っている人がリンクを開けるようにする。
      // read でまとめて許可すると list も通ってしまい、
      // コレクションを丸ごと取得するだけで全ユーザーのファイルの
      // downloadUrl（トークン付きの実ダウンロードURL）を抜き取れる。
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'owner',
          'fileId',
          'path',
          'downloadUrl',
          'fileName',
          'size',
          'createdAt',
          'expiresAt',
          'retentionDays'
        ]);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // 表計算シートの閲覧専用公開。
    // 所有者が「共有」したときだけ、その時点の内容の写しがここに置かれる。
    // 元データ（users/{uid}/sheets/*）は本人しか読めないままなので、
    // 公開したいシートだけを、コードを知っている人に見せられる。
    match /sheetShares/{code} {
      // 単体取得のみ。list を許すとコードを知らなくても全件読めてしまう
      allow get: if true;
      allow list: if false;
      function sheetShareShapeOk() {
        return request.resource.data.keys().hasOnly([
            'owner', 'sheetId', 'name', 'rows', 'cols',
            'cells', 'formats', 'merges', 'condRules', 'colWidths',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100;
      }
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && sheetShareShapeOk();
      // ★update は「今の持ち主が自分であること」も見る。
      //   request.resource（これから書く内容）の owner だけを見ていると、
      //   第三者が owner を自分の uid にして他人の公開シートを乗っ取れる。
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && sheetShareShapeOk();
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // 共有リンクのダウンロード計測ガード（/api/share/download が Admin SDK で読み書きする）。
    // クライアントから触れると計測を水増しできてしまうので完全に閉じる。
    match /shareDownloadMarks/{markId} {
      allow read, write: if false;
    }
    match /shareDownloadDaily/{dailyId} {
      allow read, write: if false;
    }

    // チャットルーム（参加者のみ読み書き可能）
    match /chatRooms/{roomId} {
      // チャットルームの読み取りは参加者のみ
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      
      // チャットルームの作成は、作成者が参加者に含まれている場合のみ
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2; // 2人用チャットのみ
      
      // チャットルームの更新は参加者のみ
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      
      // チャットルームの削除は参加者のみ（通常は削除しない）
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // ▼▼▼ 修正箇所：メッセージ（チャットルームの参加者のみ読み書き可能） ▼▼▼
      match /messages/{messageId} {
        // 読み取り許可
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants;
        
        // 作成許可：送信者が自分自身であること（厳しいフィールド制限は削除）
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        
        // 更新許可：送信者本人の修正、または受信者による既読状態の更新のみ許可
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
          && (
            // 送信者は自分のメッセージを更新可能
            resource.data.senderId == request.auth.uid
            // または、変更されたフィールドが 'readBy' か 'readAt' のみであれば許可（受信者の既読処理）
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'readAt'])
          );
        
        // 削除許可：送信者のみ
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants
          && resource.data.senderId == request.auth.uid;
      }
    }

    // スケジュール調整ツール
    match /schedules/{scheduleId} {
      function scheduleData() {
        return get(/databases/$(database)/documents/schedules/$(scheduleId)).data;
      }
      function isScheduleOwner() {
        return request.auth != null && scheduleData().ownerUid == request.auth.uid;
      }
      // 回答期限を過ぎているか。deadline は任意項目なので存在確認を挟む。
      function isPastDeadline() {
        return 'deadline' in scheduleData()
          && scheduleData().deadline != null
          && scheduleData().deadline < request.time;
      }

      // 単体取得（get）: 公開設定なら誰でも。共有URLを知っている人が開けるようにする。
      //
      // ★存在しないドキュメントでは resource が null になり、resource.data を
      //   参照した時点で評価エラー＝deny になる。ScheduleTool は新しい共有URLを
      //   発行する前に「その slug が未使用か」を getDoc で確かめるため、
      //   ここを塞ぐとスケジュールが1件も作成できなくなる。
      //   未使用 slug の確認はログインユーザーにのみ許可する。
      allow get: if resource == null
        ? request.auth != null
        : (resource.data.isPublic == true
           || (request.auth != null && resource.data.ownerUid == request.auth.uid));

      // 一覧取得（list）: 自分のスケジュールのみ。
      // get と list をまとめて read で許可すると、
      // where('isPublic','==',true) というクエリで全ユーザーの公開スケジュールを
      // 列挙でき、URL を知らない第三者にタイトル・作成者名まで見えてしまう。
      allow list: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // 作成: ログインユーザーなら誰でも作成可能（ownerUidが自分のuidであることを確認）
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid is string;
      
      // 更新・削除: オーナーのみ
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // オプション（候補）
      match /options/{optionId} {
        allow read: if get(/databases/$(database)/documents/schedules/$(scheduleId)).data.isPublic == true
          || (request.auth != null && get(/databases/$(database)/documents/schedules/$(scheduleId)).data.ownerUid == request.auth.uid);
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/schedules/$(scheduleId)).data.ownerUid == request.auth.uid;
      }

      // 参加者
      // 公開スケジュールは未ログインでも回答できる仕様なので auth は要求できない。
      // 代わりにフィールドと文字数を固定し、1件あたりのサイズを抑える
      // （旧ルールは項目数・サイズ無制限で、巨大ドキュメントを量産して
      //   Firestore の課金を膨らませることができた）。
      match /participants/{participantId} {
        allow read: if get(/databases/$(database)/documents/schedules/$(scheduleId)).data.isPublic == true
          || (request.auth != null && get(/databases/$(database)/documents/schedules/$(scheduleId)).data.ownerUid == request.auth.uid);
        // 作成・更新: 公開なら誰でも、非公開ならログインユーザーのみ。
        // ただし回答期限を過ぎたら主催者以外は書き込めない
        // （締切はこれまで画面表示だけで、ルール側は素通りだった）。
        allow create, update: if (scheduleData().isPublic == true
            || request.auth != null)
          && (!isPastDeadline() || isScheduleOwner())
          && request.resource.data.keys().hasOnly(['name', 'comment', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && (!request.resource.data.keys().hasAny(['comment'])
              || request.resource.data.comment == null
              || (request.resource.data.comment is string && request.resource.data.comment.size() <= 500));
        // 削除: オーナーのみ
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/schedules/$(scheduleId)).data.ownerUid == request.auth.uid;
      }

      // 回答
      match /responses/{responseId} {
        allow read: if get(/databases/$(database)/documents/schedules/$(scheduleId)).data.isPublic == true
          || (request.auth != null && get(/databases/$(database)/documents/schedules/$(scheduleId)).data.ownerUid == request.auth.uid);
        // 作成・更新: 公開なら誰でも、非公開ならログインユーザーのみ。
        // 参加者と同じく、回答期限を過ぎたら主催者以外は書き込めない。
        allow create, update: if (scheduleData().isPublic == true
            || request.auth != null)
          && (!isPastDeadline() || isScheduleOwner())
          && request.resource.data.keys().hasOnly(['participantId', 'optionId', 'value'])
          && request.resource.data.participantId is string
          && request.resource.data.participantId.size() <= 128
          && request.resource.data.optionId is string
          && request.resource.data.optionId.size() <= 128
          && request.resource.data.value is string
          && request.resource.data.value.size() <= 20;
        // 削除: オーナーのみ
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/schedules/$(scheduleId)).data.ownerUid == request.auth.uid;
      }
    }

    // 一時ファイル（24時間限定ファイル置き場）
    match /tempFiles/{fileId} {
      // 読み取り: 自分のファイルのみ
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      
      // 作成: ログインユーザーなら誰でも作成可能
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'url', 'storagePath', 'createdAt', 'expiresAt', 'userId'])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && (request.resource.data.size == null || request.resource.data.size is number);
      
      // 更新: 自分のファイルのみ（通常は更新しないが、念のため）
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      
      // 削除: 自分のファイルのみ
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // OLMT 図面ボード（会議の相手と同じ図面にポインタと赤入れを置く）
    // 部屋の ID は 24文字の乱数（120bit）で、リンクを知っている人だけが入れる。
    // 会議 URL と同じ考え方で、ログインしていれば誰でも「ID を知っている部屋」を開ける。
    // 一覧（list）は誰にも許さないので、ID を知らない部屋を探し当てることはできない。
    match /drawingRooms/{roomId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && roomId.size() >= 24
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      // 部屋の設定（図面の差し替え・会議の開始と終了）はオーナーだけ
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      function isRoomOwner() {
        return get(/databases/$(database)/documents/drawingRooms/$(roomId)).data.ownerUid == request.auth.uid;
      }

      // 赤入れ: 書いた本人の名前でしか書けない。消せるのは本人とオーナー。書き換えはさせない
      match /strokes/{strokeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.pts is list
          && request.resource.data.pts.size() <= 4000
          && request.resource.data.page is int;
        allow update: if false;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isRoomOwner());
      }

      // ポインタ（いまどこを指しているか）: 自分の分だけ書ける
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // 決定事項・宿題: 参加者なら誰でも書ける（会議中にみんなで書き足すもの）。消すのは書いた本人かオーナー
      match /decisions/{decisionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow update: if request.auth != null
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isRoomOwner());
      }
    }

    // 公共工事入札情報（誰でも読み取り可能、書き込みはサーバーのみ）
    match /public_works/{workId} {
      allow read: if true; // 誰でも読み取り可能
      allow write: if false; // 書き込みはサーバー（GitHub Actions）からのみ
    }
  }
}
