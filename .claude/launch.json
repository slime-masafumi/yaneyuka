{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "yaneyuka-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "yaneyuka-local-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "yaneyuka-emu",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:emu"
      ],
      "port": 3200
    }
  ]
}
