{
  "name": "yaneyuka-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20",
    "npm": "^10"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "clean": "powershell -Command \"if (Test-Path .next) { Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue }; exit 0\"",
    "clean:firebase": "rimraf .firebase || echo Firebase directory cleanup skipped",
    "predeploy": "npm run clean && npm run clean:firebase",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "export": "npm run clean && next build",
    "test:rules": "firebase emulators:exec --only firestore,auth \"node scripts/firestore-rules-test.mjs\"",
    "test:drawing-room-rules": "firebase emulators:exec --only firestore,auth,storage \"node scripts/drawing-room-rules-test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --only storage,auth \"node scripts/storage-rules-test.mjs\"",
    "deploy": "npm run predeploy && npx firebase-tools deploy",
    "deploy:preview": "npm run export && npx firebase-tools hosting:channel:deploy yane-preview --expires 7d",
    "check:links": "node scripts/check-maker-links.mjs",
    "makers:extract": "node scripts/extract-makers.mjs",
    "makers:verify": "node scripts/verify-makers.mjs",
    "knowledge:build": "node scripts/extract-knowledge.mjs",
    "knowledge:verify": "node scripts/extract-knowledge.mjs --verify",
    "makers:find-cad": "node scripts/find-cad-links.mjs",
    "makers:apply-cad": "node scripts/apply-cad-links.mjs",
    "events:update": "node scripts/update-events.mjs",
    "check:regulations": "node scripts/check-regulation-sources.mjs",
    "test:regulations": "node scripts/test-regulation-rules.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@kenjiuno/msgreader": "^1.28.0",
    "@types/dompurify": "^3.0.5",
    "@types/leaflet": "^1.9.19",
    "@types/youtube": "0.1.2",
    "@types/youtube-player": "5.5.11",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "exifr": "^7.1.3",
    "firebase": "^10.12.5",
    "firebase-admin": "^13.8.0",
    "heic-to": "^1.5.2",
    "html-docx-js": "^0.3.1",
    "html2pdf.js": "^0.14.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.561.0",
    "material-icons": "^1.13.14",
    "next": "^16.0.10",
    "nodemailer": "^9.0.3",
    "pdf-compressor": "^1.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.4.168",
    "postal-mime": "^3.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-youtube": "10.1.0",
    "screenfull": "^6.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "firebase-tools": "^14.26.0",
    "postcss": "^8",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
